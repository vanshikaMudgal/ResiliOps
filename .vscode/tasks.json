{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run ResiliOps frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"0.0.0.0"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run ResiliOps frontend with prefix",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"C:\\ResiliOps\\frontend",
				"run",
				"dev",
				"--",
				"--host",
				"0.0.0.0"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Install and run ResiliOps frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"C:\\ResiliOps\\frontend",
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start ResiliOps frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"C:\\ResiliOps\\frontend",
				"run",
				"dev",
				"--",
				"--host",
				"0.0.0.0"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build ResiliOps frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"C:\\ResiliOps\\frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Restart ResiliOps Vite server",
			"type": "shell",
			"command": "npx",
			"args": [
				"--prefix",
				"C:\\ResiliOps\\frontend",
				"vite",
				"--host",
				"127.0.0.1",
				"--port",
				"5173"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Serve ResiliOps frontend correctly",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/d",
				"/s",
				"/c",
				"cd /d C:\\ResiliOps\\frontend && npx vite --host 127.0.0.1 --port 5173"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Serve updated ResiliOps frontend",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/d",
				"/s",
				"/c",
				"cd /d C:\\ResiliOps\\frontend && npx vite --host 127.0.0.1 --port 5173"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Install ResiliOps backend dependencies",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/d",
				"/s",
				"/c",
				"cd /d C:\\ResiliOps\\backend && \"C:\\Users\\VANSHIKA MUDGAL\\AppData\\Local\\Programs\\Python\\Python314\\python.exe\" -m pip install -r requirements.txt"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install backend dependencies with Python",
			"type": "shell",
			"command": "C:\\Users\\VANSHIKA MUDGAL\\AppData\\Local\\Programs\\Python\\Python314\\python.exe",
			"args": [
				"-m",
				"pip",
				"install",
				"-r",
				"C:\\ResiliOps\\backend\\requirements.txt"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start ResiliOps backend",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/d",
				"/s",
				"/c",
				"cd /d C:\\ResiliOps\\backend && \"C:\\Users\\VANSHIKA MUDGAL\\AppData\\Local\\Programs\\Python\\Python314\\python.exe\" -m uvicorn app.main:app --host 127.0.0.1 --port 8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start ResiliOps API on port 8000",
			"type": "shell",
			"command": "C:\\Users\\VANSHIKA MUDGAL\\AppData\\Local\\Programs\\Python\\Python314\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--app-dir",
				"C:\\ResiliOps\\backend",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Find ResiliOps server ports",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/d",
				"/s",
				"/c",
				"netstat -ano | findstr \"127.0.0.1:5173 127.0.0.1:8000 0.0.0.0:5173 0.0.0.0:8000\""
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Find ResiliOps server process IDs",
			"type": "shell",
			"command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-NetTCPConnection -State Listen | Where-Object { $_.LocalPort -in 5173,8000 } | Select-Object LocalAddress,LocalPort,OwningProcess"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stop ResiliOps servers",
			"type": "shell",
			"command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Stop-Process -Id 25792 -ErrorAction SilentlyContinue; Stop-Process -Id 7692 -ErrorAction SilentlyContinue"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Initialize Git repository",
			"type": "shell",
			"command": "git",
			"args": [
				"-C",
				"C:\\ResiliOps",
				"init"
			],
			"isBackground": false
		},
		{
			"label": "Stage requested paths and verify",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/s",
				"/c",
				"git -C C:/ResiliOps rev-parse --show-toplevel && git -C C:/ResiliOps reset --mixed HEAD && git -C C:/ResiliOps add -- .gitignore backend/app backend/requirements.txt frontend/src frontend/index.html frontend/package.json frontend/package-lock.json frontend/vite.config.js \":(exclude,glob)**/node_modules/**\" \":(exclude,glob)**/dist/**\" \":(exclude,glob)**/__pycache__/**\" && git -C C:/ResiliOps status --short && git -C C:/ResiliOps diff --cached --name-only"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage selected project files",
			"type": "shell",
			"command": "git",
			"args": [
				"-C",
				"C:\\ResiliOps",
				"add",
				"--",
				".gitignore",
				"backend/app",
				"backend/requirements.txt",
				"frontend/src",
				"frontend/index.html",
				"frontend/package.json",
				"frontend/package-lock.json",
				"frontend/vite.config.js"
			]
		},
		{
			"label": "Check staged status",
			"type": "shell",
			"command": "git",
			"args": [
				"-C",
				"C:\\ResiliOps",
				"status",
				"--short"
			]
		}
	]
}