# ResiliOps Platform Environment Configuration Example
# Copy to .env for local overrides: cp .env.example .env

# Backend Configuration
DATABASE_URL=sqlite:///./resiliops.db
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
HOST=0.0.0.0

# Docker Socket (for autonomous container recovery)
DOCKER_HOST=unix:///var/run/docker.sock

# Monitoring & Prometheus
PROMETHEUS_SCRAPE_INTERVAL=5s
GRAFANA_PORT=3000

# Sample Application Port
SAMPLE_APP_PORT=8001

